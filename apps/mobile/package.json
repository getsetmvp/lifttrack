{
  "name": "@liftfuel/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "android:preview": "cross-env APP_ENV=preview expo run:android",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "bundle": "expo export --experimental-bundle",
    "ota:prepare": "node scripts/prepare-bundles.js",
    "ota:build": "pnpm bundle && pnpm ota:prepare",
    "ota:next-version": "node scripts/next-version.js",
    "ota:upload": "node scripts/upload-to-r2.js",
    "ota:publish": "pnpm ota:build && pnpm ota:upload"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo/vector-icons": "^14.0.4",
    "@liftfuel/shared-types": "workspace:*",
    "@react-navigation/native": "^7.0.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~53.0.0",
    "expo-camera": "~17.0.0",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
    "expo-image": "~2.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~5.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.30.0",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.28.0",
    "lucide-react-native": "^0.460.0",
    "nativewind": "^4.1.0",
    "react": "19.0.0",
    "react-native": "0.79.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "~5.0.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.0.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.0.0",
    "typescript": "~5.6.0"
  }
}
