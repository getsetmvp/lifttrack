{
  "name": "@liftfuel/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "android:preview": "cross-env APP_ENV=preview expo run:android",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "bundle": "expo export --experimental-bundle",
    "ota:prepare": "node scripts/prepare-bundles.js",
    "ota:build": "pnpm bundle && pnpm ota:prepare",
    "ota:next-version": "node scripts/next-version.js",
    "ota:upload": "node scripts/upload-to-r2.js",
    "ota:publish": "pnpm ota:build && pnpm ota:upload"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@liftfuel/shared-types": "workspace:*",
    "@react-navigation/native": "^7.0.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~54.0.35",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "lucide-react-native": "^0.460.0",
    "nativewind": "^4.2.4",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.5.1",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.17",
    "cross-env": "^7.0.3",
    "dotenv": "^17.0.0",
    "typescript": "~5.9.3"
  }
}
